{
  "info": {
    "_postman_id": "a76ca868-f83d-4e3a-ad85-13825384c8ba",
    "name": "Valhalla Locate",
    "description": "Локальная Valhalla: поиск ближайших дорог. Выберите окружение Valhalla — localhost:8002. search_cutoff задаётся в метрах и изменяется в окружении.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Locate — ближайшая дорога",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": "{{base_url}}/locate",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"locations\": [\n    {\n      \"lat\": 55.751244,\n      \"lon\": 37.618423,\n      \"radius\": 0,\n      \"search_cutoff\": {{search_cutoff}},\n      \"minimum_reachability\": 0\n    }\n  ],\n  \"costing\": \"auto\",\n  \"verbose\": false\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "description": "Пример для Москвы. radius=0, minimum_reachability=0, costing=auto, verbose=false. Изменяйте search_cutoff в выбранном окружении."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"Одна точка в ответе\", function () { pm.expect(pm.response.json()).to.be.an(\"array\").with.lengthOf(1); });",
              "pm.test(\"Список дорожных сегментов\", function () { pm.expect(pm.response.json()[0].edges).to.be.an(\"array\"); });"
            ]
          }
        }
      ]
    }
  ]
}
